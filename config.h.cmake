/* config.h, generated by CMake from config.h.cmake.
 *
 * Only what the kdepim sources test is defined here (see
 * ConfigureChecks.cmake); the autotools config.h also carried fallback
 * prototypes and portability blocks for systems that are not supported
 * any more.
 */

/* Name and version of package */
#define PACKAGE "kdepim"
#define VERSION "@KDEPIM_VERSION@"

/* Enable GNU extensions on systems that have them (AC_CHECK_GNU_EXTENSIONS) */
#ifndef _GNU_SOURCE
# define _GNU_SOURCE 1
#endif

/* Number of bits in a file offset, on hosts where this is settable. */
#cmakedefine _FILE_OFFSET_BITS @_FILE_OFFSET_BITS@

/* ---- system ------------------------------------------------------- */

#cmakedefine HAVE_BYTESWAP_H 1
#cmakedefine HAVE_ERR_H 1
#cmakedefine HAVE_FCNTL_H 1
#cmakedefine HAVE_INTTYPES_H 1
#cmakedefine HAVE_PATHS_H 1
#cmakedefine HAVE_STDINT_H 1
#cmakedefine HAVE_SYS_CDEFS_H 1
#cmakedefine HAVE_SYS_STAT_H 1
#cmakedefine HAVE_SYS_TYPES_H 1

/* Define to 1 if you have the `snprintf' function. */
#cmakedefine HAVE_SNPRINTF 1

/* Define WORDS_BIGENDIAN to 1 if your processor stores words with the
   most significant byte first. */
#cmakedefine WORDS_BIGENDIAN 1

/* define if you have a timezone variable */
#cmakedefine HAVE_TIMEZONE 1
/* Define if you have a tm_gmtoff member in struct tm */
#cmakedefine HAVE_TM_GMTOFF 1

/* Define if your version of stl is defined in namespace std */
#cmakedefine HAVE_STLNAMESPACE 1
/* Namespace prefix the stl is defined in */
#define STD_NAMESPACE_PREFIX @STD_NAMESPACE_PREFIX@

/* The size of a `unsigned long long', `unsigned long', `uint64_t' */
#define SIZEOF_UNSIGNED_LONG_LONG @SIZEOF_UNSIGNED_LONG_LONG@
#define SIZEOF_UNSIGNED_LONG @SIZEOF_UNSIGNED_LONG@
#cmakedefine SIZEOF_UINT64_T @SIZEOF_UINT64_T@

/* Maximum length of command line arguments */
#define MAX_CMD_LENGTH @MAX_CMD_LENGTH@

/* Define if your system has Linux Inode Notification */
#cmakedefine HAVE_INOTIFY 1

/* ---- gpgme -------------------------------------------------------- */

/* Always set since gpgme >= 0.4.5 is required */
#cmakedefine HAVE_GPGME_0_4_BRANCH 1
/* Define to 1 if your gpgme supports gpgme_cancel() */
#cmakedefine HAVE_GPGME_CANCEL 1
/* Define to 1 if your gpgme has the GPGME_INCLUDE_CERTS_DEFAULT macro */
#cmakedefine HAVE_GPGME_INCLUDE_CERTS_DEFAULT 1
/* Define to 1 if your gpgme supports GPGME_KEYLIST_MODE_VALIDATE */
#cmakedefine HAVE_GPGME_KEYLIST_MODE_VALIDATE 1
/* Define to 1 if your gpgme's gpgme_key_t has the keylist_mode member */
#cmakedefine HAVE_GPGME_KEY_T_KEYLIST_MODE 1
/* Define to 1 if your gpgme supports gpgme_op_getauditlog */
#cmakedefine HAVE_GPGME_OP_GETAUDITLOG 1
/* Define to 1 if your gpgme has the trust item listing
   (gpgme_op_trustlist_*, gpgme_trust_item_*; removed in gpgme 2) */
#cmakedefine HAVE_GPGME_OP_TRUSTLIST 1
/* Define to 1 if your gpgme's gpgme_decrypt_result_t has the
   wrong_key_usage member */
#cmakedefine HAVE_GPGME_WRONG_KEY_USAGE 1

/* ---- optional features -------------------------------------------- */

/* Define if you want to use the new distribution lists */
#cmakedefine KDEPIM_NEW_DISTRLISTS 1

/* Define if you have cyrus-sasl2 libraries */
#cmakedefine HAVE_LIBSASL2 1

/* Define if the sieve KIO::Slave must be able to talk to timsieved <= 1.1.0 */
#cmakedefine HAVE_BROKEN_TIMSIEVED 1

/* Define if you want EXPERIMENTAL full-text indexing in KMail */
#cmakedefine HAVE_INDEXLIB 1

/* Define if you have gnokii.h */
#cmakedefine HAVE_GNOKII_H 1

/* Define if you have gio-unix-2.0 (KMail watches logind for suspend) */
#cmakedefine HAVE_GIO_UNIX 1

/* ---- libical ------------------------------------------------------ */

/* unix newline */
#cmakedefine ICAL_UNIX_NEWLINE 1
/* safe saves */
#define ICAL_SAFESAVES 1
